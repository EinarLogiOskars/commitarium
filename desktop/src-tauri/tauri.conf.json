{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commitarium",
  "version": "0.5.0",
  "identifier": "com.einarlogi.commitarium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Commitarium",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMDZCQjRDOEEzQzFBREYKUldUZkdqeUtUTHNHSEJCRVZEL2lNa1dreVZXcWdsMzlVaWxqTXkxeWo4UEZSajM5YmpvZDZuV04K",
      "endpoints": [
        "https://github.com/EinarLogiOskars/commitarium/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
