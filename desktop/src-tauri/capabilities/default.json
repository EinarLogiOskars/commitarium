{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window; the apps' windows get theirs at runtime (app_pages.rs)",
  "windows": [
    "main"
  ],
  "permissions": [
    "main-window",
    "core:default",
    "core:window:allow-set-fullscreen",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8080/*"
        }
      ],
      "deny": []
    }
  ]
}
