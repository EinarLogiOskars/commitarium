---
// A placeholder landing page: the docs live under /docs/. To be redesigned.
import "@fontsource-variable/geist";

const releases = "https://github.com/EinarLogiOskars/commitarium/releases";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Commitarium</title>
    <meta
      name="description"
      content="Describe any app. Commitarium builds it, runs it, and changes it whenever you want."
    />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <main>
      <span class="mark" aria-hidden="true"></span>
      <h1>Commitarium</h1>
      <p class="pitch">
        Describe any app. Commitarium builds it, runs it, and changes it whenever you want.
      </p>
      <div class="actions">
        <a class="button button--primary" href={releases}>Download</a>
        <a class="button" href={`${base}/docs/`}>Read the docs</a>
      </div>
      <p class="small">For macOS, Windows and Linux. Needs Docker and a Claude or Codex subscription or API key.</p>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #ffffff;
    --text: #171717;
    --muted: #666666;
    --border: #eaeaea;
    --accent: #171717;
    --accent-text: #ffffff;
    --hover: #f4f4f4;
    --blue: #0070f3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --text: #ededed;
      --muted: #a1a1a1;
      --border: #242424;
      --accent: #ededed;
      --accent-text: #0a0a0a;
      --hover: #141414;
      --blue: #3b8eff;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--text);
    font:
      16px/1.5 "Geist Variable",
      ui-sans-serif,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 40rem;
    padding: 4rem 16px;
    text-align: center;
  }
  .mark {
    display: inline-block;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
  }
  h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .pitch {
    margin: 0 auto 2rem;
    max-width: 30rem;
    color: var(--muted);
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .button {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .button:hover {
    background: var(--hover);
  }
  .button--primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }
  .button--primary:hover {
    background: var(--accent);
    opacity: 0.88;
  }
  .button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .small {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
