---
/**
 * A screenshot of the app in both themes: /screens/<id>-light.png shows in
 * light mode, /screens/<id>-dark.png in dark mode. Starlight sets data-theme
 * on <html>; theme.css hides the other image.
 */
interface Props {
  id: string;
  alt: string;
  caption?: string;
}

const { id, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const src = (theme: "light" | "dark") => `${base}/screens/${id}-${theme}.png`;
---

<figure class="screenshot not-content">
  <img class="screenshot__img--light" src={src("light")} alt={alt} loading="lazy" decoding="async" />
  <img class="screenshot__img--dark" src={src("dark")} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
